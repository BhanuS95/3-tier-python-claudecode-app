# Never bake secrets or local env into the image
.env
.env.*
!.env.example

# Version control
.git
.gitignore

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*
*.egg-info/

# Virtual environments
venv/
.venv/
env/

# Tests (not needed in the runtime image)
tests/

# IDE / OS
.vscode/
.idea/
.DS_Store

# Dev-only dependency list (not installed in the production image)
requirements-dev.txt
