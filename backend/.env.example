# Used when running the backend directly on your machine (not via
# docker-compose). Copy to backend/.env:
#     cp backend/.env.example backend/.env
#
# See the root .env.example for the full variable reference table.

APP_ENV=development
APP_PORT=5000
APP_DEBUG=true
LOG_LEVEL=DEBUG
SECRET_KEY=change-me

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=taskdb
DATABASE_USER=taskuser
DATABASE_PASSWORD=changeme

CORS_ORIGINS=*
