# ============================================================================
# Environment configuration template.
#
# Copy this file to .env and fill in real values for local development:
#     cp .env.example .env
#
# NEVER commit the real .env file. It is excluded via .gitignore.
# In Docker Compose, these values are read directly by the "backend"
# and "postgres" services. In production/Kubernetes, these are supplied
# as Secrets/ConfigMaps by DevOps -- this file is documentation, not a
# deployment artifact.
# ============================================================================

# --- Application ------------------------------------------------------------
APP_ENV=development          # development | testing | production
APP_PORT=5000                # Port the Flask/Gunicorn backend listens on
APP_DEBUG=true                # true only in development; must be false/unset in production
LOG_LEVEL=DEBUG               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# SECRET_KEY is used by Flask for session/signing purposes.
# Generate a strong value for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Gunicorn worker count (production server). Rule of thumb: (2 x CPU cores) + 1
GUNICORN_WORKERS=4

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=taskdb
DATABASE_USER=taskuser
DATABASE_PASSWORD=changeme

# Optional: pool tuning
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed origins in production, e.g.:
#   CORS_ORIGINS=https://tasks.example.com
# "*" is acceptable only for local development.
CORS_ORIGINS=*

# --- Frontend ------------------------------------------------------------------
# Base URL the frontend JavaScript uses to reach the backend API when NOT
# proxied through the frontend's own Nginx (see frontend/js/app.js).
API_BASE_URL=http://localhost:5000
